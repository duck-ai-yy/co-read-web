# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔘 唯一开关：切换 provider 改这一行
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
LLM_PROVIDER=openrouter
# 可选: deepseek / gemini / glm / qwen / kimi / openrouter

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 各 provider 的 API key（只需填你用的那个，切 provider 时 key 不丢）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GLM_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
OPENROUTER_API_KEY=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 可选：覆盖 provider 默认的 model（如换 OpenRouter 上别的免费模型）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LLM_MODEL=
# LLM_BASE_URL=

# OpenRouter 免费模型推荐 (LLM_MODEL=...):
#   google/gemini-2.0-flash-exp:free          (默认)
#   deepseek/deepseek-chat-v3-0324:free       (长 context)
#   meta-llama/llama-3.3-70b-instruct:free    (推理强)

# 拿 key 的地方:
#   openrouter → https://openrouter.ai/keys                (聚合层，免费模型多)
#   gemini     → https://aistudio.google.com/apikey        (免费层易爆)
#   deepseek   → https://platform.deepseek.com/            (便宜+稳)
#   glm        → https://open.bigmodel.cn/
#   qwen       → https://dashscope.aliyuncs.com/
#   kimi       → https://platform.moonshot.cn/
